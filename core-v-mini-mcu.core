name: openhwgroup.org:systems:core-v-mini-mcu:1.0.6
description: CORE-V MINI-MCU Top.

filesets:
  files_rtl_generic:
    depend:
    - x-heep::packages
    - openhwgroup.org:ip:cv32e40p
    - openhwgroup.org:ip:cv32e40x
    - openhwgroup:cve2:cve2_top
    - pulp-platform.org:ip:gpio
    - pulp-platform.org::common_cells
    - pulp-platform.org::axi:0.39.9
    - pulp-platform.org::riscv_dbg
    - pulp-platform.org::register_interface
    - openhwgroup.org:ip:soc_ctrl
    - lowrisc:ip:uart:0.1
    - lowrisc:ip:rv_plic_example:0.1
    - lowrisc:ip:rv_timer:0.1
    - lowrisc:ip:spi_host:1.0
    - lowrisc:ip:i2c:0.1
    - x-heep:ip:cv32e40px
    - x-heep:ip:boot_rom
    - x-heep:ip:dma
    - x-heep:ip:dma_subsystem
    - x-heep:ip:i2s
    - x-heep:ip:spi
    - x-heep:ip:cluster_interconnect
    - x-heep:ip:power_manager
    - x-heep:ip:fast_intr_ctrl
    - x-heep:ip:obi_fifo
    - x-heep:ip:pdm2pcm
    - x-heep:ip:serial_link_xheep_wrapper
    - esl_epfl:ip:obi_spi_slave
    - x-heep:ip:w25q128jw_controller
    files:
    - hw/core-v-mini-mcu/core_v_mini_mcu.sv
    - hw/core-v-mini-mcu/cpu_subsystem.sv
    - hw/core-v-mini-mcu/cve2_xif_wrapper.sv
    - hw/core-v-mini-mcu/cv32e40px_xif_wrapper.sv
    - hw/core-v-mini-mcu/memory_subsystem.sv
    - hw/core-v-mini-mcu/xbar_varlat_one_to_n.sv
    - hw/core-v-mini-mcu/xbar_varlat_n_to_one.sv
    - hw/core-v-mini-mcu/system_bus.sv
    - hw/core-v-mini-mcu/system_xbar.sv
    - hw/core-v-mini-mcu/debug_subsystem.sv
    - hw/core-v-mini-mcu/peripheral_subsystem.sv
    - hw/core-v-mini-mcu/ao_peripheral_subsystem.sv
    file_type: systemVerilogSource

  rtl-simulation:
    depend:
    - pulp-platform.org::tech_cells_generic
    - x-heep:sim:sram_wrapper
    - x-heep:sim:pad_cells

  # tech_cells_generic's own `rtl_sim` fileset (tc_sram, tc_clk_gating, ...)
  # is gated on `target_sim`/`target_sim_sc`
  # (see hw/vendor/pulp_platform_tech_cells_generic.core), so depending on
  # `pulp-platform.org::tech_cells_generic` from a differently-named target
  # (like `sim_postsynthesis`) pulls in nothing. Reference the files
  # directly instead - the same workaround `rtl-sky130` below already uses.
  # Needed by testharness.sv's "external device example" block
  # (slow_memory's tc_sram, dma's tc_clk_gating), independently of the DUT.
  tb-tech-cells-sim:
    files:
    - hw/vendor/pulp_platform/tech_cells_generic/src/rtl/tc_clk.sv
    - hw/vendor/pulp_platform/tech_cells_generic/src/rtl/tc_sram.sv
    file_type: systemVerilogSource

  x_heep_system:
    depend:
    - x-heep::packages
    - x-heep:ip:pad_control
    - x-heep:ip:pad-ring
    files:
    - hw/system/x_heep_system.sv
    file_type: systemVerilogSource

  tb-utils:
    depend:
    - x-heep::tb-utils
    - x-heep::tb-fpu-utils

  files_verilator_waiver:
    depend:
    - openhwgroup.org:ip:verilator_waiver
    files:
    - hw/core-v-mini-mcu/core_v_mini_mcu.vlt
    - hw/ip/soc_ctrl/soc_ctrl.vlt
    - hw/ip/dma_subsystem/dma_subsystem.vlt
    - hw/ip/pdm2pcm/pdm2pcm.vlt
    - hw/ip/power_manager/power_manager.vlt
    - hw/ip/fast_intr_ctrl/fast_intr_ctrl.vlt
    - hw/ip/serial_link_xheep_wrapper/serial_link_xheep_wrapper.vlt
    - hw/system/pad_control/pad_control.vlt
    - hw/system/x_heep_system.vlt
    file_type: vlt

  rtl-fpga:
    depend:
    - x-heep:x-heep:x-heep-fpga-support
    files:
    - hw/fpga/xilinx_core_v_mini_mcu_wrapper.sv
    file_type: systemVerilogSource

  ip-asic:
    depend:
    - technology::prim_mytech

  ip-asic-ihp:
    depend:
    - technology::prim_ihp-sg13g2

  ip-asic-tsmc65:
    depend:
    - technology::prim_tsmc65

  # Chip-level wrapper used ONLY to give `x_heep_system` a synthesizable
  # boundary when it is NOT the direct synthesis top (kept for reference /
  # alternative flows). Not used by the `x_heep_system`-as-top flow below.
  ip-asic-ihp-wrapper:
    files:
    - hw/asic/ihp-sg13g2/rtl/asic_x_heep_system_wrapper.sv
    file_type: systemVerilogSource

  # Post-synthesis gate-level netlist of one of the ASIC flows
  # (`asic_{yosys,dc}_{ihp130,tsmc65}` below), staged at a fixed path after
  # each run by `make <tool>-<tech>-stage-netlist`, which also records its
  # technology in implementation/postsynth/asic_tech (read by the
  # `pre_build_postsyn_models` hook). Its top module is
  # `x_heep_system_synth_top` (see generate_xif_tieoff_wrapper.py):
  # synthesis resolves away all of `x_heep_system`'s parameters, so this
  # module can no longer accept the parameter overrides `testharness.sv`
  # passes when instantiating `x_heep_system`. The `postsynthesis-sim-shim`
  # fileset below bridges that gap.
  postsynthesis-netlist:
    files:
    - implementation/postsynth/x_heep_system_netlist.v
    file_type: verilogSource

  # Simulation-only shim, generated alongside the netlist by
  # `make <tool>-<tech>-stage-netlist` (scripts/sim/modelsim/generate_postsyn_sim_shim.py).
  # It is module `x_heep_system` with the exact parameter/port list of the
  # RTL `x_heep_system` (so `testharness.sv`'s instantiation - including its
  # parameter overrides - still elaborates unchanged), and it simply
  # instantiates the real netlist (`x_heep_system_synth_top`) via `.*`,
  # ignoring the (already synthesis-resolved, functionally irrelevant)
  # parameters.
  postsynthesis-sim-shim:
    files:
    - implementation/postsynth/x_heep_system_postsyn_sim_shim.sv
    file_type: systemVerilogSource

  # Pre-build hook: vlog-compiles the functional Verilog simulation models
  # (std cells, IO pads, SRAM macros) of the staged netlist's technology into
  # the separate QuestaSim library `pdk_lib`. Needed because their location
  # in the design kit ($IHP130 / $TSMC65) is only known at run time (see
  # scripts/asic/tech/<tech>.tcl).
  pre_build_postsyn_models:
    files:
    - scripts/sim/modelsim/compile_postsyn_models.sh
    file_type: user

  # Pre-build hook: generates x_heep_system_synth_top.sv, a synthesis-only
  # top that ties off x_heep_system's 6 unconnected `if_xif` interface ports
  # (see scripts/synthesis/yosys/generate_xif_tieoff_wrapper.py for why this
  # is needed and how it is used by edalize_yosys_template.tcl).
  generate_xif_tieoff_wrapper:
    files:
    - scripts/synthesis/yosys/generate_xif_tieoff_wrapper.py
    file_type: user

  rtl-sky130:
    files:
    - hw/asic/sky130/sram_wrapper.sv
    - hw/vendor/openhwgroup/cv32e20/bhv/cve2_sim_clock_gate.sv #as for now use the simulation clk gating
    - hw/vendor/openhwgroup/cv32e40p/bhv/cv32e40p_sim_clock_gate.sv
    - hw/vendor/pulp_platform/tech_cells_generic/src/deprecated/pulp_clk_cells.sv #as for now use the simulation clk cells
    - hw/vendor/pulp_platform/tech_cells_generic/src/deprecated/cluster_clk_cells.sv #as for now use the simulation clk cells
    - hw/vendor/pulp_platform/tech_cells_generic/src/rtl/tc_clk.sv #as for now use the simulation clk cells
    file_type: systemVerilogSource

  lib-sky130:
    files:
      - hw/asic/sky130/sky130_sram_4kbyte_1rw_32x1024_8_TT_1p8V_25C.lib : { copyto: lib/sky130_sram_4kbyte_1rw_32x1024_8_TT_1p8V_25C.lib }

  # Scripts for hooks
  post_build_modelsim_scripts:
    files:
    - scripts/sim/modelsim/post_build_modelsim_vopt.sh
    file_type: user

  pre_build_remote_bitbang:
    files:
    - scripts/sim/compile_remote_bitbang.sh
    file_type: user

  pre_build_uartdpi:
    files:
    - scripts/sim/compile_uart_dpi.sh
    file_type: user

  cfile_uartdpi:
    files:
    - ./hw/vendor/lowrisc/opentitan/hw/dv/dpi/uartdpi/uartdpi.c
    - ./hw/vendor/lowrisc/opentitan/hw/dv/dpi/uartdpi/uartdpi.h: { is_include_file: true }
    file_type: cSource

  pre_patch_modelsim_Makefile:
    files:
    - scripts/sim/modelsim/patch_modelsim_Makefile.py
    file_type: user

  pre_patch_vcs_ams_Makefile:
    files:
    - scripts/sim/vcs/patch_vcs_ams_Makefile.py
    file_type: user

  tb-verilator:
    files:
    - tb/XHEEP_CmdLineOptions.hh: { is_include_file: true }
    - tb/XHEEP_CmdLineOptions.cpp
    - tb/tb_top.cpp
    file_type: cppSource

  tb-sv:
    files:
    - tb/tb_top.sv
    file_type: systemVerilogSource

  tb-sc-verilator:
    files:
    - tb/XHEEP_CmdLineOptions.hh: { is_include_file: true }
    - tb/XHEEP_CmdLineOptions.cpp
    - tb/tb_sc_top.cpp
    file_type: cppSource

  openroad_base_files:
    files:
      - flow/OpenROAD-flow-scripts/flow/Makefile : {file_type: Makefile}
    depend:
      - core-v-mini:util:sv2v

  openroad_sky130_files:
    files:
      - hw/asic/sky130/config.mk : {file_type: configFile}
      - hw/asic/sky130/constraint.sdc : {file_type: SDC}

parameters:
  JTAG_DPI:
    datatype: int
    paramtype: vlogparam
    description: |
      Enables testbench JTAG DIPs. Admitted values: 1|0.
    default: 0
  USE_EXTERNAL_DEVICE_EXAMPLE:
    datatype: int
    paramtype: vlogparam
    description: |
      Enables testbench modules compilation. Admitted values: 1|0.
    default: 1
  USE_UPF:
    datatype: bool
    paramtype: vlogdefine
    description: |
      Enables simulation with UPF with Modelsim/VCS
  REMOVE_OBI_FIFO:
    datatype: bool
    paramtype: vlogdefine
    description: |
      Remove the FIFO between the BUS and the peripherals subsystems
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
    default: false
  VERILATOR: #used by SV2V
    datatype: bool
    paramtype: vlogdefine
    default: false
  SIM_SYSTEMC:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_NEXYS:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_ZCU104:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_ZCU102:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_AUP_ZU3:
    datatype: bool
    paramtype: vlogdefine
    default: false
  FPGA_GENESYS2:
    datatype: bool
    paramtype: vlogdefine
    default: false
  NO_DDR_CLK_PORTS:
    datatype: bool
    paramtype: vlogdefine
    default: false
  PRIM_DEFAULT_IMPL:
    datatype: str
    paramtype: vlogdefine
    description: Primitives implementation to use, e.g. "prim_pkg::ImplGeneric".
    default: prim_pkg::ImplGeneri
  COMMON_CELLS_ASSERTS_OFF:
    datatype: bool
    description: Turn off asserts for PULP common cells
    paramtype: vlogdefine
    default: false
  ASSERTS_OFF:
    datatype: bool
    description: Turn off asserts for PULP common cells
    paramtype: vlogdefine
    default: false

scripts:
  # Build utils
  post_build_modelsim_scripts:
    cmd:
    - sh
    - ../../../scripts/sim/modelsim/post_build_modelsim_vopt.sh
  pre_build_remote_bitbang:
    cmd:
    - sh
    - ../../../scripts/sim/compile_remote_bitbang.sh
  pre_build_uartdpi:
    cmd:
    - sh
    - ../../../scripts/sim/compile_uart_dpi.sh
  pre_patch_modelsim_Makefile:
    cmd:
    - python
    - ../../../scripts/sim/modelsim/patch_modelsim_Makefile.py
  pre_patch_vcs_ams_Makefile:
    cmd:
    - python
    - ../../../scripts/sim/vcs/patch_vcs_ams_Makefile.py
  pre_build_postsyn_models:
    cmd:
    - sh
    - ../../../scripts/sim/modelsim/compile_postsyn_models.sh

  # ASIC synthesis utils
  generate_yosys_filelist:
    cmd:
    - sh
    - ../../../scripts/synthesis/yosys/generate_yosys_filelist.sh
  generate_xif_tieoff_wrapper:
    cmd:
    - python
    - ../../../scripts/synthesis/yosys/generate_xif_tieoff_wrapper.py
  # Design Compiler variant: struct ports as plain vectors (see the script)
  generate_xif_tieoff_wrapper_plain:
    cmd:
    - python
    - ../../../scripts/synthesis/yosys/generate_xif_tieoff_wrapper.py
    - --plain-ports
  # Record the target technology in the build directory (asic_tech.tcl), read
  # by the yosys template and the DC script (-> scripts/asic/tech/<tech>.tcl)
  asic_tech_ihp130:
    cmd: [sh, -c, "echo 'set ASIC_TECH ihp130' > asic_tech.tcl"]
  asic_tech_tsmc65:
    cmd: [sh, -c, "echo 'set ASIC_TECH tsmc65' > asic_tech.tcl"]

  # Simulation utils
  remove_uart_log:
    cmd: [sh, -c, rm -f uart0.log]
  print_uart_log:
    cmd: [sh, -c, cat uart0.log]

targets:
  default: &default_target
    filesets:
    - files_rtl_generic
    - target_sim ? (tool_verilator? (files_verilator_waiver))
    - target_sim_sc ? (tool_verilator? (files_verilator_waiver))
    toplevel: [core_v_mini_mcu]

  sim:
    <<: *default_target
    default_tool: modelsim
    filesets_append:
    - tb-utils
    - rtl-simulation
    - tool_modelsim? (pre_build_remote_bitbang)
    - tool_modelsim? (pre_build_uartdpi)
    - tool_modelsim? (pre_patch_modelsim_Makefile)
    - tool_vcs? (cfile_uartdpi)
    - tool_vcs? (pre_build_remote_bitbang)
    - tool_xcelium? (pre_build_remote_bitbang)
    - tool_xcelium? (pre_build_uartdpi)
    - tool_verilator? (tb-verilator)
    - tool_modelsim? (tb-sv)
    - tool_vcs? (tb-sv)
    - tool_xcelium? (tb-sv)
    - "!integrated_heep? (x_heep_system)"
    toplevel:
    - tool_modelsim? (tb_top)
    - tool_vcs? (tb_top)
    - tool_xcelium? (tb_top)
    - tool_verilator? (testharness)
    hooks:
      pre_build:
        - tool_modelsim? (pre_build_uartdpi)
        - tool_modelsim? (pre_build_remote_bitbang)
        - tool_modelsim? (pre_patch_modelsim_Makefile) # this is required by Questa 2020 on
        - ams_sim? (pre_patch_vcs_ams_Makefile)
        - tool_xcelium? (pre_build_uartdpi)
        - tool_xcelium? (pre_build_remote_bitbang)
      pre_run:
        - remove_uart_log
      post_run:
        - print_uart_log
    parameters:
    - JTAG_DPI
    - USE_EXTERNAL_DEVICE_EXAMPLE
    - USE_UPF
    - REMOVE_OBI_FIFO
    - COMMON_CELLS_ASSERTS_OFF
    - ASSERTS_OFF
    tools:
      modelsim:
        vlog_options:
        - -override_timescale 1ns/1ps
        - -suppress vlog-2583
        - -suppress vlog-2577
        - -suppress vlog-2720
        - -pedanticerrors
        - -define MODELSIM
        vsim_options:
        - -sv_lib ../../../hw/vendor/lowrisc/opentitan/hw/dv/dpi/uartdpi/uartdpi
        - -sv_lib ../../../hw/vendor/pulp_platform/pulpissimo/rtl/tb/remote_bitbang/librbs
        - -voptargs=+acc=npr
      vcs:
        vcs_options:
         - -override_timescale=1ns/1ps
         - -assert disable_cover
         - -assert svaext
         - -debug_access+all+dmptf
         - -fgp
         - -full64
         - -kdb
         - -notice
         - -ntb_opts error
         - -race=all
         - -xlrm uniq_prior_final
         - -CFLAGS "-std=c++14 -pthread"
         - -LDFLAGS "-pthread -lutil"
         - +lint=TFIPC-L
         - -V
      xcelium:
        xrun_options:
        - -vtimescale 1ns/10ps
        - -sv_lib ../../../hw/vendor/lowrisc/opentitan/hw/dv/dpi/uartdpi/uartdpi.so
        - -sv_lib ../../../hw/vendor/pulp_platform/pulpissimo/rtl/tb/remote_bitbang/librbs.so
        - -define XCELIUM
      verilator:
        mode: cc
        verilator_options:
          - '--sv'
          - '--cc'
          - '--trace'
          - '--trace-fst'
          - '--trace-structs'
          - '--trace-params'
          - '--trace-max-array 1024'
          - '--x-assign unique'
          - '--x-initial unique'
          - '--exe tb_top.cpp'
          - '-CFLAGS "-Wall -fpermissive"'
          - '-LDFLAGS "-pthread -lutil -lelf"'
          - "-Wall"
        make_options:
          # Use the number of available cores (up to a max of 8) for parallel compilation, with a fallback to 4 if nproc is not available
          - '-j$(shell N=$$(nproc 2>/dev/null || echo 4); [ "$$N" -le 8 ] && echo "$$N" || echo 8)'

  # Post-synthesis gate-level simulation of the netlist of one of the ASIC
  # flows (`asic_{yosys,dc}_{ihp130,tsmc65}`), wrapped in a shim with the
  # interface of the RTL `x_heep_system`, so `tb_top`/`testharness` are
  # reused unmodified. Requirements:
  #   - stage the netlist first: `make <tool>-<tech> <tool>-<tech>-stage-netlist`
  #     (copies it to implementation/postsynth/, generates the shim and records
  #     the technology in implementation/postsynth/asic_tech);
  #   - export the design kit of that technology ($IHP130 / $TSMC65) before
  #     building, so scripts/sim/modelsim/compile_postsyn_models.sh can
  #     vlog-compile the std-cell/IO-pad/SRAM functional Verilog models it
  #     references (see scripts/asic/tech/<tech>.tcl);
  #   - boot from flash (`+boot_sel=1` at run time): the JTAG force-load path
  #     (tb_loadHEX) pokes DUT-internal hierarchy that does not survive
  #     synthesis, while flash boot (load_flash_hex -> spiflash model) and
  #     real JTAG_DPI both stay at the pad level and work unchanged.
  # NOTE: deliberately NOT built on `*default_target`: the gate-level netlist
  # is self-contained after synthesis (see the `files_rtl_generic` note below).
  sim_postsynthesis:
    default_tool: modelsim
    description: QuestaSim post-synthesis (gate-level) simulation of the staged ASIC netlist
    filesets:
    # `files_rtl_generic` is NOT needed by the DUT itself (the netlist is
    # self-contained), but `testharness.sv`'s "external device example"
    # block (slow_memory, dma, dlc, im2col_spc, ams, iffifo, ...)
    # instantiates shared leaf IP (xbar_varlat_*, lowrisc prim_subreg*/
    # prim_fifo_sync, the if_xif interface definition, ...) independently of
    # the DUT, so it is still required to compile the testbench.
    # `tb-tech-cells-sim` covers that same block's tc_sram/tc_clk_gating use
    # (see its own comment above for why `rtl-simulation` doesn't).
    - files_rtl_generic
    - tb-tech-cells-sim
    - tb-utils
    - postsynthesis-netlist
    - postsynthesis-sim-shim
    - pre_build_remote_bitbang
    - pre_build_uartdpi
    - pre_patch_modelsim_Makefile
    - pre_build_postsyn_models
    - tb-sv
    toplevel: [tb_top]
    hooks:
      pre_build:
        - tool_modelsim? (pre_build_uartdpi)
        - tool_modelsim? (pre_build_remote_bitbang)
        - tool_modelsim? (pre_patch_modelsim_Makefile) # this is required by Questa 2020 on
        - tool_modelsim? (pre_build_postsyn_models)
      pre_run:
        - remove_uart_log
      post_run:
        - print_uart_log
    parameters:
    - JTAG_DPI
    - USE_EXTERNAL_DEVICE_EXAMPLE
    - REMOVE_OBI_FIFO
    - COMMON_CELLS_ASSERTS_OFF
    - ASSERTS_OFF
    tools:
      modelsim:
        vlog_options:
        - -override_timescale 1ns/1ps
        - -suppress vlog-2583
        - -suppress vlog-2577
        - -suppress vlog-2720
        - -pedanticerrors
        - -define MODELSIM
        # Stubs out tb_util.svh's JTAG force-load tasks (they reference
        # DUT-internal hierarchy that does not exist in the netlist).
        - -define POSTSYNTHESIS
        - +notimingcheck
        - +nospecify
        vsim_options:
        - -sv_lib ../../../hw/vendor/lowrisc/opentitan/hw/dv/dpi/uartdpi/uartdpi
        - -sv_lib ../../../hw/vendor/pulp_platform/pulpissimo/rtl/tb/remote_bitbang/librbs
        - -voptargs=+acc=npr
        - +bus_conflict_off
        # Resolves the library cell/macro instances in the netlist against
        # the models compiled by compile_postsyn_models.sh (kept separate
        # from `work`, see that script for why).
        - -L pdk_lib

  sim_sc:
    <<: *default_target
    default_tool: verilator
    filesets_append:
    - tb-utils
    - rtl-simulation
    - tool_verilator? (tb-sc-verilator)
    - "!integrated_heep? (x_heep_system)"
    toplevel:
    - tool_verilator? (testharness)
    parameters:
    - JTAG_DPI
    - USE_EXTERNAL_DEVICE_EXAMPLE
    - USE_UPF
    - REMOVE_OBI_FIFO
    - SIM_SYSTEMC=true
    - COMMON_CELLS_ASSERTS_OFF
    - ASSERTS_OFF
    hooks:
      pre_run:
        - remove_uart_log
      post_run:
        - print_uart_log
    tools:
      verilator:
        mode: sc
        verilator_options:
          - '--sc'
          - '--trace'
          - '--trace-structs'
          - '--trace-params'
          - '--trace-max-array 1024'
          - '--x-assign unique'
          - '--x-initial unique'
          - '--exe tb_sc_top.cpp'
          - '-CFLAGS "-Wall -std=c++14 -fpermissive"'
          - '-LDFLAGS "-pthread -lutil -lelf"'
          - "-Wall"

  nexys-a7-100t:
    <<: *default_target
    default_tool: vivado
    description: Digilent Nexys-A7-100T Board
    filesets_append:
    - x_heep_system
    - rtl-fpga
    parameters:
    - SYNTHESIS=true
    - REMOVE_OBI_FIFO
    - FPGA_SYNTHESIS=true
    - FPGA_NEXYS=true
    - NO_DDR_CLK_PORTS=true
    tools:
