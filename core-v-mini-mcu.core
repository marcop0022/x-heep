  asic_synthesis:
    <<: *default_target
    default_tool: design_compiler
    description: Design Compiler Script
    parameters:
    - PRIM_DEFAULT_IMPL=prim_pkg::your_target_technology
    - SYNTHESIS=true
    - REMOVE_OBI_FIFO
    filesets_append:
    - ip-asic
    toplevel: [core_v_mini_mcu]
    tools:
      design_compiler:
        script_dir:
        - ../../../scripts/synthesis/dc_shell
        report_dir:
        - report
        dc_script:
        - dc_script.tcl

  # ASIC synthesis flows: `asic_<tool>_<tech>`, tool = yosys | dc (Synopsys
  # Design Compiler), tech = ihp130 (IHP-SG13G2) | tsmc65 (TSMC 65nm LP).
  # Run them with `make <tool>-<tech>` (see the Makefile), which needs the
  # design kit of the technology exported ($IHP130 / $TSMC65, see
  # scripts/asic/tech/<tech>.tcl); every netlist can then be simulated with
  # `make <tool>-<tech>-stage-netlist questasim-build-postsynth questasim-run-postsynth`.
  # The technology cells come from `ip-asic-<tech>` (hw/asic/<tech>/), and the
  # `asic_tech_<tech>` hook records the technology for the synthesis scripts.
  # NOTE: the actual synthesis top is `x_heep_system_synth_top`, generated by
  # the `generate_xif_tieoff_wrapper[_plain]` hook: `x_heep_system` exposes 6
  # unconnected `if_xif` SystemVerilog interface ports at its boundary (used
  # only when a CPU extension is enabled), which a synthesis top cannot have,
  # so this thin wrapper ties them off. The output netlist module is therefore
  # named `x_heep_system_synth_top`, NOT `x_heep_system` - a separate
  # simulation-only shim (module `x_heep_system`, generated by
  # `make <tool>-<tech>-stage-netlist`) bridges it back for `tb_top`/
  # `testharness` in the `sim_postsynthesis` target; see the
  # `postsynthesis-sim-shim` fileset for why.
  asic_yosys_ihp130:
    <<: *default_target
    default_tool: yosys
    description: Yosys synthesis of X-HEEP for IHP-SG13G2
    parameters:
      - SYNTHESIS=true
      - REMOVE_OBI_FIFO
    filesets_append:
      - x_heep_system
      - ip-asic-ihp
      - generate_xif_tieoff_wrapper
    hooks:
      pre_build:
        - generate_yosys_filelist
        - generate_xif_tieoff_wrapper
        - asic_tech_ihp130
    toplevel: [x_heep_system]
    tools: &asic_yosys_tools
      yosys:
        arch: generic
        output_format: verilog
        yosys_template: ../../../scripts/synthesis/yosys/edalize_yosys_template.tcl

  asic_yosys_tsmc65:
    <<: *default_target
    default_tool: yosys
    description: Yosys synthesis of X-HEEP for TSMC 65nm LP
    parameters:
      - SYNTHESIS=true
      - REMOVE_OBI_FIFO
    filesets_append:
      - x_heep_system
      - ip-asic-tsmc65
      - generate_xif_tieoff_wrapper
    hooks:
      pre_build:
        - generate_yosys_filelist
        - generate_xif_tieoff_wrapper
        - asic_tech_tsmc65
    toplevel: [x_heep_system]
    tools: *asic_yosys_tools

  # Design Compiler: the edalize `design_compiler` backend analyzes the RTL of
  # the target and sources scripts/synthesis/dc/dc_script.tcl, which also
  # reads the generated top (plain-vector ports: see
  # generate_xif_tieoff_wrapper.py --plain-ports) and writes
  # x_heep_system_netlist.v in the build directory.
  asic_dc_ihp130:
    <<: *default_target
    default_tool: design_compiler
    description: Design Compiler synthesis of X-HEEP for IHP-SG13G2
    parameters:
      - SYNTHESIS=true
      - REMOVE_OBI_FIFO
      - ASSERTS_OFF
      - COMMON_CELLS_ASSERTS_OFF
    filesets_append:
      - x_heep_system
      - ip-asic-ihp
      - generate_xif_tieoff_wrapper
    hooks:
      pre_build:
        - generate_xif_tieoff_wrapper_plain
        - asic_tech_ihp130
    toplevel: [x_heep_system]
    tools: &asic_dc_tools
      design_compiler:
        script_dir:
        - ../../../scripts/synthesis/dc
        report_dir:
        - report
        dc_script:
        - dc_script.tcl

  asic_dc_tsmc65:
    <<: *default_target
    default_tool: design_compiler
    description: Design Compiler synthesis of X-HEEP for TSMC 65nm LP
    parameters:
      - SYNTHESIS=true
      - REMOVE_OBI_FIFO
      - ASSERTS_OFF
      - COMMON_CELLS_ASSERTS_OFF
    filesets_append:
      - x_heep_system
      - ip-asic-tsmc65
      - generate_xif_tieoff_wrapper
    hooks:
      pre_build:
        - generate_xif_tieoff_wrapper_plain
        - asic_tech_tsmc65
    toplevel: [x_heep_system]
    tools: *asic_dc_tools
